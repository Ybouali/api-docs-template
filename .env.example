# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  API Developer Portal Template
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy this file to .env.local (never commit .env.local to git).
# Vite only exposes variables prefixed VITE_ to the browser bundle.
#
# NEVER put real secrets here. These variables are included in the compiled JS
# and are publicly visible to anyone who downloads the page.
#
# ─── Runtime overrides ───────────────────────────────────────────────────────

# Override the sandbox API base URL at build time (useful in CI/CD pipelines).
# Defaults to siteConfig.api.sandboxUrl when not set.
# VITE_API_BASE_URL=https://api-sandbox.example.com

# Override the production API base URL at build time.
# VITE_API_PRODUCTION_URL=https://api.example.com

# Canonical site URL used for Open Graph og:url and canonical link tags.
# VITE_SITE_URL=https://docs.example.com

# ─── Build metadata (injected by CI, not secrets) ────────────────────────────

# Inject the git tag / release version from your CI pipeline.
# Overrides siteConfig.api.version when set.
# VITE_APP_VERSION=2.1.0

# ─────────────────────────────────────────────────────────────────────────────
# How to use in src/config/site.ts:
#
#   sandboxUrl: import.meta.env.VITE_API_BASE_URL ?? 'https://api-sandbox.example.com',
#   version:    import.meta.env.VITE_APP_VERSION  ?? '1.0',
#
# See https://vitejs.dev/guide/env-and-mode for full documentation.
# ─────────────────────────────────────────────────────────────────────────────
